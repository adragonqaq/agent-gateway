<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 多租户 ReAct Agent 网关：父工程，统一版本与依赖对齐 -->
    <groupId>com.agent</groupId>
    <artifactId>agent-gateway</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>agent-gateway</name>
    <description>多租户 ReAct Agent 网关（MCP 优先，不含 RAG）</description>

    <!-- 模块依赖方向：bootstrap → gateway-api → runtime → (tools|memory|observe|tenant)；mcp-server 独立进程 -->
    <modules>
        <module>tenant</module>       <!-- 租户 / API Key / 策略 -->
        <module>tools</module>        <!-- MCP 注册与工具目录 -->
        <module>memory</module>       <!-- 会话与 Agent 状态 -->
        <module>observe</module>      <!-- 审计与用量 -->
        <module>runtime</module>      <!-- ReAct 执行、确认门、并发闸 -->
        <module>gateway-api</module>  <!-- HTTP / SSE 接入 -->
        <module>bootstrap</module>    <!-- Spring Boot 启动入口 -->
        <module>mcp-server</module>   <!-- 演示 MCP Server（独立进程，不进 bootstrap） -->
    </modules>

    <properties>
        <java.version>17</java.version>
        <!-- Spring Boot：Web / JDBC / 配置绑定等基础设施 -->
        <spring-boot.version>3.4.5</spring-boot.version>
        <!-- AgentScope：ReActAgent、Toolkit、流式事件 -->
        <agentscope.version>2.0.2</agentscope.version>
        <!-- 官方 MCP Java SDK：与远端 MCP Server 通信（tools 模块发现工具） -->
        <mcp-sdk.version>0.17.0</mcp-sdk.version>
        <!-- Redisson：可选 Redis RunGate（多实例并发闸门） -->
        <redisson.version>3.45.1</redisson.version>
        <!-- Testcontainers：后续集成测试（Postgres/Redis）预留 -->
        <testcontainers.version>1.20.6</testcontainers.version>
        <!-- Springdoc：Swagger UI / OpenAPI 3 -->
        <springdoc.version>2.8.5</springdoc.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 导入 Spring Boot BOM，统一第三方版本 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- AgentScope 核心：ReAct 循环、权限 ASK、事件流 -->
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-core</artifactId>
                <version>${agentscope.version}</version>
            </dependency>
            <!-- AgentScope OpenAI 兼容模型适配（GatewayAgentProperties.chat） -->
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-extensions-model-openai</artifactId>
                <version>${agentscope.version}</version>
            </dependency>
            <!-- MCP 协议客户端 SDK -->
            <dependency>
                <groupId>io.modelcontextprotocol.sdk</groupId>
                <artifactId>mcp</artifactId>
                <version>${mcp-sdk.version}</version>
            </dependency>
            <!-- Redis 客户端；仅 gateway.run-gate.type=redis 时实际建连 -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- 本仓库内部模块版本对齐 -->
            <dependency>
                <groupId>com.agent</groupId>
                <artifactId>tenant</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.agent</groupId>
                <artifactId>tools</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.agent</groupId>
                <artifactId>memory</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.agent</groupId>
                <artifactId>observe</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.agent</groupId>
                <artifactId>runtime</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.agent</groupId>
                <artifactId>gateway-api</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- 可执行 jar 打包（bootstrap 使用） -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <!-- 统一 Java 17 编译；parameters=true 保留方法参数名供 Spring 注入 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
